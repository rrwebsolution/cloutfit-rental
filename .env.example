# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (https://resend.com/api-keys) ──────────────────────────────────────
# SECRET. Server only.
RESEND_API_KEY=
# Sender shown on emails. Must be on a domain verified in Resend.
# Without a verified domain, leave blank: the Resend test sender is used, which
# can only deliver to the email address of your own Resend account.
RESEND_FROM_EMAIL=
# Gmail inbox that receives new-reservation / fitting / payment notifications.
# Can be overridden later in Admin → Settings → Notifications.
ADMIN_NOTIFICATION_EMAIL=you@example.com

# ── Gmail SMTP (alternative to Resend; no domain needed) ──────────────────────
# When BOTH are set, emails are sent through this Gmail account instead of
# Resend, and can reach any recipient (about 500 emails/day).
# GMAIL_APP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# It is NOT your normal Gmail password. SECRET. Server only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Sender name customers see. Defaults to "Cloutfit Rental".
GMAIL_FROM_NAME=Cloutfit Rental

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the site, used for links inside emails. No trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SECRET. Any long random string. Protects the daily rental-reminder cron job.
# Vercel sends it automatically once it is set as an environment variable.
CRON_SECRET=
